{
  "name": "inoreader-mcp",
  "version": "1.0.1",
  "description": "MCP server for the Inoreader RSS reader API. Analyze feed health, triage articles, and manage subscriptions from Claude.",
  "type": "module",
  "bin": {
    "inoreader-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --outDir .dist-new && rm -rf .dist-old && mv dist .dist-old 2>/dev/null; mv .dist-new dist && rm -rf .dist-old",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
    "start:http": "MCP_TRANSPORT=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "inoreader",
    "rss",
    "model-context-protocol",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/inoreader-mcp"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
