# Inoreader app (https://www.inoreader.com/developers/register-app)
INOREADER_CLIENT_ID=1000000000
# Inoreader app secret
INOREADER_CLIENT_SECRET=your-client-secret
# Must byte-match the app's redirect URI; point it at this server's /callback
INOREADER_REDIRECT_URI=https://inoreader-mcp.example.com/callback
# Optional: ntfy server for keepalive failure alerts, e.g. https://ntfy.sh
NTFY_URL=
# Optional: ntfy topic
NTFY_TOPIC=
# Optional: ntfy access token
NTFY_TOKEN=
# Optional: comma-separated hostnames clients use, e.g. mcp.example.com
MCP_ALLOWED_HOSTS=
# Optional: "on" enables the taste index (similar_saved, check_novelty, ...); see the README
INOREADER_TASTE_INDEX=
# Optional: path inside the container of the taste index's sources/tiers JSON, e.g. /config/taste.json
# (also uncomment the taste.json volume in compose.yaml). Empty = starred + highlights.
INOREADER_TASTE_CONFIG=
# Optional: Karakeep base URL and API key, for a "karakeep" source in that file
KARAKEEP_API_URL=
KARAKEEP_API_KEY=
